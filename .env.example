# =============================================================================
# CreatorForge — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it's in .gitignore.
#
# All variables are validated at runtime with Zod.
# Missing or invalid values cause a hard crash with a descriptive error.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase free tier or Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/creatorforge"

# ── Auth (NextAuth.js) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# From Google Cloud Console → APIs & Services → Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── YouTube API ───────────────────────────────────────────────────────────────
# From Google Cloud Console → YouTube Data API v3
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ── Redis ─────────────────────────────────────────────────────────────────────
# Upstash Redis connection string (free tier)
REDIS_URL="redis://default:password@host:6379"

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-"

# ── Cloudflare R2 (thumbnail storage) ─────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="creatorforge-thumbnails"
R2_PUBLIC_URL="https://cdn.creatorforge.com"

# ── Replicate (thumbnail generation — cheaper alternative to DALL-E) ──────────
REPLICATE_API_TOKEN=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""

# ── Stripe (billing) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_"
STRIPE_WEBHOOK_SECRET="whsec_"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_"

# ── Sentry (error monitoring) ─────────────────────────────────────────────────
SENTRY_DSN=""
